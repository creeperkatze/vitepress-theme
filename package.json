{
	"name": "@creeperkatze/vitepress-theme",
	"version": "0.1.0",
	"description": "Shared VitePress theme for Creeperkatze project websites",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/theme/index.ts",
		"./config": {
			"types": "./dist/config.d.ts",
			"default": "./dist/config.js"
		}
	},
	"files": [
		"src/",
		"dist/"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "pnpm build",
		"typecheck": "vue-tsc --noEmit"
	},
	"dependencies": {
		"intl-messageformat": "^12.1.2",
		"vite-svg-loader": "^5.1.3",
		"vue-i18n": "^11.4.12"
	},
	"peerDependencies": {
		"vitepress": "^1.6.4",
		"vue": "^3.5.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"typescript": "^6.0.3",
		"vite": "^5.4.21",
		"vitepress": "^1.6.4",
		"vue": "^3.5.43",
		"vue-tsc": "^3.3.11"
	}
}
